PORT=5000
NODE_ENV=development
# MongoDB Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017/relis_local
# Same client ID as the frontend, used to verify Google ID tokens
GOOGLE_CLIENT_ID=
# Secret for signing the app's own JWT
JWT_SECRET=replace-with-a-local-random-secret-at-least-32-characters
# Allowed origin for CORS (Vercel URL in production)
CLIENT_URL=http://localhost:5173
# Gemini API key for AI feedback (US49), from Google AI Studio
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
