PORT=5000
# MongoDB Atlas connection string
MONGODB_URI=
# Same client ID as the frontend, used to verify Google ID tokens
GOOGLE_CLIENT_ID=
# Secret for signing the app's own JWT
JWT_SECRET=
# Allowed origin for CORS (Vercel URL in production)
# One site, or several separated by commas: https://your-domain,https://relis-ielts.vercel.app
CLIENT_URL=http://localhost:5173
# Gemini API key for AI feedback (US49), from Google AI Studio
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Cloudinary for cover images and audio (cloudinary.com > Dashboard > API environment variable)
CLOUDINARY_URL=
